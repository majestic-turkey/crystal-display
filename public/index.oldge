<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <link rel="stylesheet" href="./assets/styles.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>E-Ink Test Layout</title>
    </head>
    <body>
        <main class="panel">
            <header class="topbar" id="cell-0">
                <div class="clock">08:42</div>
                <div class="status">Tue Sep 01</div>
                <div class="wifi">WiFi 78%</div>
            </header>

            <section class="metrics" id="cell-1">
                <article class="metric metric-invert" id="cell-2">
                    <h2>Temp</h2>
                    <p>72F</p>
                </article>
                <article class="metric" id="cell-3">
                    <h2>Humidity</h2>
                    <p>41%</p>
                </article>
                <article class="metric" id="cell-4">
                    <h2>AQI</h2>
                    <p>23</p>
                </article>
            </section>

            <section class="content-grid">
                <article class="card" id="cell-5">
                    <h3>Today</h3>
                    <ul>
                        <li>09:30 Standup</li>
                        <li>11:00 Design Review</li>
                        <li>13:15 Lunch Walk</li>
                        <li>15:00 Deep Work Block</li>
                    </ul>
                </article>

                <article class="card" id="cell-6">
                    <h3>Headlines</h3>
                    <p class="truncate">Long text clipping test: this line should truncate cleanly on narrow e-ink displays without ugly wrapping artifacts.</p>
                    <div class="bars" aria-label="contrast bars">
                        <span class="bar b0"></span>
                        <span class="bar b1"></span>
                        <span class="bar b2"></span>
                        <span class="bar b3"></span>
                        <span class="bar b4"></span>
                    </div>
                </article>
            </section>

            <footer class="footer" id="cell-7">
                <span>Render Test: lines, fills, text scale</span>
                <span class="badge" id="cell-8">v2 layout</span>
            </footer>
        </main>
    </body>
</html>